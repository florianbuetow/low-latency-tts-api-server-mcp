+// Serve mode keeps the model loaded and handles one request per stdin line:
+//   <voice>\t<save-path>\t<phonemes>
+// Each request is answered on stdout with "@@done\t<save-path>" or "@@error\t<message>".
+// "@@ready" is printed once the model is loaded. The loop ends when stdin is closed.
+static int serve_requests(tts_generation_runner & runner, generation_configuration config) {
+    printf("@@ready\n");
+    fflush(stdout);
+    std::string line;
+    while (std::getline(std::cin, line)) {
+        const size_t first_tab = line.find('\t');
+        const size_t second_tab = first_tab == std::string::npos ? std::string::npos : line.find('\t', first_tab + 1);
+        if (second_tab == std::string::npos) {
+            printf("@@error\tmalformed request, expected <voice>\\t<save-path>\\t<phonemes>\n");
+            fflush(stdout);
+            continue;
+        }
+        config.voice = line.substr(0, first_tab);
+        const std::string save_path = line.substr(first_tab + 1, second_tab - first_tab - 1);
+        const std::string prompt = line.substr(second_tab + 1);
+        tts_response data;
+        runner.generate(prompt.c_str(), data, config);
+        if (data.n_outputs == 0) {
+            printf("@@error\tgot empty response for prompt '%s'\n", prompt.c_str());
+            fflush(stdout);
+            continue;
+        }
+        write_audio_file(data, save_path, runner.sampling_rate);
+        printf("@@done\t%s\n", save_path.c_str());
+        fflush(stdout);
+    }
+    return 0;
+}
